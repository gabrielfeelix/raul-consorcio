---
// Botão fixo no celular: aparece depois da abertura e some quando a simulação está na tela.
// O tráfego vem do Instagram e de anúncios, quase todo pelo celular.
import Seta from "./Seta.astro";
---

<div class="barra" data-barra aria-hidden="true">
  <a href="#simulacao" class="btn barra__btn" tabindex="-1">
    <img src="/img/raul-avatar.webp" alt="" class="barra__av" width="32" height="32" />
    Simular com o Raul<Seta />
  </a>
</div>

<style>
  .barra {
    display: none;
  }
  @media (max-width: 860px) {
    .barra {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 60;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      background: linear-gradient(0deg, rgba(11, 11, 12, 0.95) 55%, rgba(11, 11, 12, 0));
      transform: translateY(110%);
      transition: transform 0.5s var(--ease);
    }
    .barra.is-on {
      transform: none;
    }
    .barra__btn {
      width: 100%;
      justify-content: center;
      height: 56px;
      padding-left: 12px;
    }
    .barra__av {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255, 255, 255, 0.85);
      margin-right: auto;
    }
    .barra__btn :global(.btn__seta) {
      margin-left: auto;
    }
  }
</style>

<script>
  const barra = document.querySelector<HTMLElement>("[data-barra]");
  const hero = document.querySelector(".hero");
  const sim = document.querySelector("#simulacao");
  const rod = document.querySelector(".rod");
  if (barra && hero && sim) {
    let passouHero = false;
    let naSim = false;
    let noRod = false;
    if (rod)
      new IntersectionObserver(([e]) => {
        noRod = e.isIntersecting;
        atualizar();
      }).observe(rod);
    const atualizar = () => {
      const on = passouHero && !naSim && !noRod;
      barra.classList.toggle("is-on", on);
      barra.setAttribute("aria-hidden", String(!on));
      barra.querySelector("a")!.tabIndex = on ? 0 : -1;
    };
    new IntersectionObserver(([e]) => {
      passouHero = !e.isIntersecting;
      atualizar();
    }).observe(hero);
    new IntersectionObserver(([e]) => {
      naSim = e.isIntersecting;
      atualizar();
    }).observe(sim);
  }
</script>
