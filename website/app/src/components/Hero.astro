---
import Onda from "./Onda.astro";
import Seta from "./Seta.astro";
---

<section class="hero" id="topo">
  <div class="hero__foto" data-parallax>
    <img src="/img/hero.webp" alt="Raul Carvalho explicando um plano no escritório" fetchpriority="high" />
  </div>

  <div class="hero__in wrap">
    <h1 class="display hero__h1" data-split>
      <span class="linha"><span>Seu próximo</span></span>
      <span class="linha"><span>grande passo</span></span>
      <span class="linha"><span>começa com um plano.</span></span>
    </h1>
    <div class="hero__lado">
      <p class="hero__sub" data-reveal>Consultoria personalizada com Raul Carvalho. Presencial e online.</p>
      <div class="hero__acoes" data-reveal>
        <a href="#simulacao" class="btn"><Onda texto="Simular meu consórcio" /><Seta /></a>
        <a href="#construcao" class="hero__link">Como funciona</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__foto {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    transform: translateY(-7%) scale(1.08);
    transform-origin: 50% 0%;
  }
  .hero__foto::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--preto) 0%, rgba(11, 11, 12, 0.8) 22%, rgba(11, 11, 12, 0.15) 50%, rgba(11, 11, 12, 0) 70%);
  }
  .hero__in {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    padding-bottom: clamp(40px, 8vh, 88px);
  }
  .hero__h1 {
    font-size: clamp(40px, 6.4vw, 104px);
    font-weight: 500;
    letter-spacing: -0.055em;
  }
  h1 em {
    font-style: normal;
    color: var(--vermelho);
  }
  .hero__lado {
    display: flex;
    align-items: center;
    gap: 16px 48px;
    flex-wrap: wrap;
    margin-top: clamp(24px, 4vh, 40px);
  }
  .hero__sub {
    max-width: 23em;
    font-size: 17px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
  }
  .hero__acoes {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 24px;
  }
  .hero__link {
    font-size: 15px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    padding-bottom: 2px;
  }
  .hero__link:hover {
    color: var(--branco);
    border-color: var(--branco);
  }
  @media (max-width: 700px) {
    .hero__foto {
      bottom: 34%;
    }
    .hero__foto img {
      transform: none;
    }
    .hero__foto::after {
      background: linear-gradient(0deg, var(--preto) 0%, rgba(11, 11, 12, 0) 45%);
    }
    .hero__acoes {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
    }
    .hero__acoes .btn {
      justify-content: center;
      height: 56px;
    }
    .hero__link {
      align-self: center;
    }
  }
</style>
