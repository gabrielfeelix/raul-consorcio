---
import { modalidades } from "../data/site";
import Seta from "./Seta.astro";

const quando = [
  ["ja", "O quanto antes", "Aí o lance faz diferença"],
  ["1-2", "Em 1 a 2 anos", "Tempo para juntar uma reserva"],
  ["3-5", "Em 3 a 5 anos", "Planejamento com calma"],
  ["sem", "Sem pressa", "É para construir patrimônio"],
];
const lance = [
  ["nao", "Ainda não", "Tudo bem, dá para começar assim"],
  ["pouco", "Um pouco", "Até uns 10% do valor"],
  ["bom", "Sim, uma boa reserva", "Mais de 10% do valor"],
  ["bem", "Tenho um bem para usar", "Um carro ou imóvel que pode vender"],
];
const etapas = ["Objetivo", "Valor", "Prazo", "Lance"];
---

<section class="sim" id="simulacao">
  <div class="wrap sim__in">
    <div class="sim__intro">
      <h2 class="display sim__titulo" data-split>
        <span class="linha"><span>Simule a sua</span></span>
        <span class="linha"><span>parcela.</span></span>
      </h2>
      <p class="sim__texto" data-reveal>Responda no seu tempo. Não existe resposta errada e nada aqui te compromete: é só um ponto de partida para conversar com o Raul. Você vê o resultado sem precisar deixar contato.</p>
      <div class="sim__resumo" data-reveal>
        <p class="sim__resumo-t">Seu plano</p>
        <dl>
          <div><dt>Objetivo</dt><dd><button type="button" class="lacuna" data-lacuna="0">—</button></dd></div>
          <div><dt>Valor</dt><dd><button type="button" class="lacuna" data-lacuna="1">—</button></dd></div>
          <div><dt>Prazo</dt><dd><button type="button" class="lacuna" data-lacuna="2">—</button></dd></div>
          <div><dt>Reserva para lance</dt><dd><button type="button" class="lacuna" data-lacuna="3">—</button></dd></div>
        </dl>
      </div>
    </div>

    <form class="sim__card" data-sim novalidate>
      <div class="sim__barra" aria-hidden="true"><i data-sim-barra></i></div>
      <p class="sr" data-sim-n aria-live="polite">Pergunta 1 de 4</p>

      <fieldset class="sim__passo" data-passo="objetivo">
        <legend>O que você quer conquistar?</legend>
        <div class="sim__ops">
          {
            modalidades.map((m) => (
              <label class="op">
                <input type="radio" name="objetivo" value={m.id} />
                <span class="op__c">
                  <img class="op__img" src={`/img/mod/${m.id}.webp`} alt="" loading="lazy" />
                  <span class="op__t">
                    <b>{m.nome}</b>
                    <small>{m.usos.slice(0, 3).map((u, k) => (k ? u[0].toLowerCase() + u.slice(1) : u)).join(", ")}</small>
                  </span>
                  <i class="op__r" />
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="sim__passo" data-passo="valor" hidden>
        <legend>Qual o valor aproximado do que você quer?<small class="sim__dica">Pode ser uma ideia. Depois o Raul ajusta com você.</small></legend>
        <div class="sim__ops" data-ops-valor></div>
      </fieldset>

      <fieldset class="sim__passo" data-passo="quando" hidden>
        <legend>Para quando você precisa?</legend>
        <div class="sim__ops">
          {
            quando.map(([v, t, s]) => (
              <label class="op">
                <input type="radio" name="quando" value={v} />
                <span class="op__c">
                  <span class="op__t"><b>{t}</b><small>{s}</small></span>
                  <i class="op__r" />
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="sim__passo" data-passo="lance" hidden>
        <legend>Você tem algum valor guardado para dar de lance?<small class="sim__dica">Lance é uma oferta em dinheiro (ou um bem) para ser contemplado antes.</small></legend>
        <div class="sim__ops">
          {
            lance.map(([v, t, s]) => (
              <label class="op">
                <input type="radio" name="lance" value={v} />
                <span class="op__c">
                  <span class="op__t"><b>{t}</b><small>{s}</small></span>
                  <i class="op__r" />
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="sim__passo sim__res" data-passo="resultado" hidden>
        <p class="res__rot">Parcela estimada</p>
        <p class="res__valor"><strong data-res-parcela>—</strong><span>/mês</span></p>
        <ul class="res__chips">
          <li>Carta de <b data-res-carta>—</b></li>
          <li><b data-res-prazo>—</b> de plano</li>
        </ul>

        <div class="res__plano">
          <div class="res__bandeira">
            <span class="res__marco-meta" data-res-meta-txt>Você quer o bem aqui<small>por sorteio ou lance</small></span>
          </div>
          <div class="res__trilho">
            <i class="res__meta" data-res-meta></i>
          </div>
          <div class="res__marcos">
            <span>Hoje<small>começa a pagar</small></span>
            <span>Fim do plano<small data-res-fim>—</small></span>
          </div>
        </div>

        <div class="res__cmp">
          <div class="res__barra">
            <span>Consórcio</span>
            <div><i data-cmp-c></i></div>
            <b data-cmp-cv>—</b>
          </div>
          <div class="res__barra res__barra--fin">
            <span>Financiamento</span>
            <div><i data-cmp-f></i></div>
            <b data-cmp-fv>—</b>
          </div>
          <p class="res__eco"><b data-cmp-eco>—</b> a menos em juros</p>
        </div>

        <div class="res__dica">
          <img src="/img/raul-avatar.webp" alt="" width="32" height="32" loading="lazy" />
          <p data-res-caminho></p>
        </div>

        <a class="btn res__zap" data-res-zap href="#" target="_blank" rel="noopener">Enviar resultado no WhatsApp<Seta /></a>
        <details class="res__contato">
          <summary>Prefere que o Raul te chame? Deixe seu contato.</summary>
            <div class="sim__contato">
              <label>
                <span>Seu nome</span>
                <input name="nome" autocomplete="name" required />
              </label>
              <label>
                <span>WhatsApp</span>
                <input name="fone" type="tel" inputmode="tel" autocomplete="tel" placeholder="(44) 9 0000-0000" required />
              </label>
            </div>
            <label class="sim__lgpd">
              <input type="checkbox" name="lgpd" />
              <span>Autorizo o Raul a falar comigo pelo WhatsApp sobre esta simulação. <a href="/privacidade" target="_blank">Política de privacidade</a></span>
            </label>
            <button type="submit" class="btn sim__enviar">Quero minha análise<Seta /></button>
        </details>
        <p class="sim__res-nota">
          Estimativa com taxas médias de mercado. O valor real depende da administradora, do grupo e da estratégia de lance.
        </p>
      </div>

      <div class="sim__nav">
        <button type="button" class="sim__voltar" data-sim-voltar hidden>← Voltar</button>
        <p class="sim__nota-nav" data-sim-nota>Toque numa opção para seguir</p>
      </div>
    </form>
  </div>
</section>

<style is:global>
  .sim {
    background: var(--papel);
    color: #111;
    padding: clamp(72px, 10vh, 120px) 0;
  }
  .sim__in {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .sim__intro {
    position: sticky;
    top: 110px;
  }
  .sim__titulo {
    font-size: clamp(40px, 4.4vw, 72px);
  }
  .sim__texto {
    margin-top: 18px;
    max-width: 24em;
    font-size: 17px;
    line-height: 1.5;
    color: #45454a;
  }
  .sim__resumo {
    margin-top: 36px;
    max-width: 26em;
  }
  .sim__resumo-t {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .sim__resumo dl {
    margin: 0;
    border-top: 1px solid var(--linha-clara);
  }
  .sim__resumo dl div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--linha-clara);
    font-size: 15px;
  }
  .sim__resumo dt {
    color: #6b6b6f;
  }
  .sim__resumo dd {
    margin: 0;
    text-align: right;
  }
  .lacuna {
    font: inherit;
    font-weight: 600;
    color: #c7c7cc;
    background: none;
    border: 0;
    padding: 0;
    cursor: default;
  }
  .lacuna.is-cheia {
    color: #111;
    cursor: pointer;
  }
  .lacuna.is-cheia:hover {
    color: var(--vermelho);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sim__raul {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
    font-size: 14px;
    font-weight: 500;
    color: #45454a;
  }
  .sim__raul img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }

  /* Card */
  .sim__card {
    display: flex;
    flex-direction: column;
    background: var(--branco);
    border: 1px solid var(--linha-clara);
    border-radius: 20px;
    padding: clamp(24px, 3vw, 44px);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .sim__barra {
    height: 2px;
    margin: 0 0 28px;
    border-radius: 2px;
    background: var(--linha-clara);
    overflow: hidden;
  }
  .sim__barra i {
    display: block;
    height: 100%;
    width: 6%;
    background: var(--vermelho);
    transition: width 0.6s var(--ease);
  }
  .sim__etapas {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }
  .sim__etapas li {
    font-size: 12px;
    font-weight: 600;
    color: #a1a1a6;
    transition: color 0.3s var(--ease);
  }
  .sim__etapas li::before {
    content: "";
    display: block;
    height: 3px;
    border-radius: 99px;
    background: var(--cinza-claro);
    margin-bottom: 10px;
    transition: background-color 0.4s var(--ease);
  }
  .sim__etapas li.is-feito,
  .sim__etapas li.is-atual {
    color: #111;
  }
  .sim__etapas li.is-feito::before,
  .sim__etapas li.is-atual::before {
    background: var(--vermelho);
  }

  .sim__passo {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .sim__passo[hidden] {
    display: none;
  }
  .sim__passo:not([hidden]) {
    animation: sim-entra 0.45s var(--ease);
  }
  @keyframes sim-entra {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .sim legend {
    padding: 0;
    font-size: clamp(26px, 2.4vw, 38px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.12;
    margin-bottom: 20px;
  }
  .sim__dica {
    display: block;
    margin-top: 8px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.45;
    color: #6b6b6f;
  }

  /* Opções em linha */
  .sim__ops {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }
  .op {
    position: relative;
    cursor: pointer;
    display: block;
  }
  .op input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .op__c {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 68px;
    padding: 12px 18px 12px 12px;
    border: 1px solid var(--linha-clara);
    border-radius: 14px;
    background: var(--branco);
    transition:
      border-color 0.25s var(--ease),
      background-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .op__c:not(:has(.op__img)) {
    padding-left: 20px;
  }
  .op__img {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    object-fit: cover;
    flex: none;
  }
  .op__t {
    flex: 1;
    min-width: 0;
  }
  .op__t b {
    display: block;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    transition: color 0.3s var(--ease);
  }
  .op__t small {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    color: #6b6b6f;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .op__r {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1.5px solid #c7c7cc;
    position: relative;
    transition:
      border-color 0.25s var(--ease),
      background-color 0.25s var(--ease);
  }
  .op__r::after {
    content: "";
    position: absolute;
    left: 7px;
    top: 3px;
    width: 6px;
    height: 11px;
    border: solid var(--branco);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg) scale(0);
    transition: transform 0.25s var(--ease);
  }
  .op:hover .op__c {
    border-color: #111;
  }
  .op:hover .op__r {
    border-color: #111;
  }
  .op input:checked + .op__c {
    border-color: var(--vermelho);
    background: rgba(166, 17, 31, 0.04);
    box-shadow: inset 0 0 0 1px var(--vermelho);
  }
  .op input:checked + .op__c .op__r {
    border-color: var(--vermelho);
    background: var(--vermelho);
  }
  .op input:checked + .op__c .op__r::after {
    transform: rotate(45deg) scale(1);
  }
  .op input:focus-visible + .op__c {
    outline: 2px solid #111;
    outline-offset: 3px;
  }

  /* Rodapé do card */
  .sim__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
    min-height: 36px;
  }
  .sim__voltar {
    background: none;
    border: 0;
    padding: 8px 0;
    font: inherit;
    font-weight: 600;
    color: #6b6b6f;
    cursor: pointer;
  }
  .sim__voltar:hover {
    color: #111;
  }
  .sim__nota-nav {
    margin-left: auto;
    font-size: 13px;
    color: #a1a1a6;
  }

  /* Resultado */
  .sim__res-rot {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--vermelho);
    margin-bottom: 14px;
  }
  .res__destaque span {
    display: block;
    font-size: 14px;
    color: #6b6b6f;
  }
  .res__destaque strong {
    display: block;
    margin: 4px 0 6px;
    font-size: clamp(32px, 3.4vw, 48px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }
  .res__destaque em {
    font-style: normal;
    font-size: 14px;
    color: #6b6b6f;
  }
  .res__destaque em b {
    color: #111;
  }
  .res__ficha {
    margin: 18px 0 0;
    border-top: 1px solid var(--linha-clara);
  }
  .res__ficha div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--linha-clara);
    font-size: 14px;
  }
  .res__ficha dt {
    color: #6b6b6f;
  }
  .res__ficha dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }
  .cmp__base {
    margin-top: 8px;
    font-size: 12.5px;
    line-height: 1.45;
    color: #8e8e93;
  }
  .cmp {
    margin-top: 22px;
    padding: 18px 20px;
    border-radius: 12px;
    background: #f6f6f7;
  }
  .cmp__t {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b6b6f;
    margin-bottom: 10px;
  }
  .cmp__linha {
    display: grid;
    grid-template-columns: 104px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 6px 0;
    font-size: 14px;
    font-weight: 600;
  }
  .cmp__barra {
    height: 10px;
    border-radius: 99px;
    background: #e6e6e9;
    overflow: hidden;
  }
  .cmp__barra i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: #111;
    transition: width 0.9s var(--ease);
  }
  .cmp__linha--fin .cmp__barra i {
    background: var(--vermelho);
  }
  .cmp__linha strong {
    font-variant-numeric: tabular-nums;
  }
  .cmp__eco {
    margin-top: 10px;
    font-size: 15px;
  }
  .cmp__eco strong {
    color: #1f7a4d;
  }
  .res__zap {
    margin-top: 18px;
    height: 50px;
  }
  @media (max-width: 900px) {
    .res__zap {
      width: 100%;
      justify-content: center;
    }
  }
  .res__caminho {
    margin-top: 20px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
  }
  .res__caminho b {
    font-weight: 600;
    color: var(--vermelho);
  }
  .sim__res-nota {
    margin-top: 14px;
    font-size: 12.5px;
    color: #8e8e93;
  }

  .res__contato {
    margin-top: 24px;
    padding: 24px;
    border-radius: 14px;
    background: #111;
    color: var(--branco);
  }
  .res__contato h3 {
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .res__contato > p {
    margin-top: 4px;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.7);
  }
  .sim__contato {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 20px;
  }
  .sim__contato label span {
    display: block;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 6px;
    color: rgba(255, 255, 255, 0.8);
  }
  .sim__contato input {
    width: 100%;
    height: 52px;
    padding: 0 14px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    font: inherit;
    color: var(--branco);
    background: rgba(255, 255, 255, 0.06);
  }
  .sim__contato input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }
  .sim__contato input:focus {
    outline: none;
    border-color: var(--branco);
  }
  .sim__contato input[aria-invalid="true"] {
    border-color: #ff6b76;
  }
  .sim__lgpd {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-top: 16px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
  }
  .sim__lgpd input {
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    accent-color: var(--vermelho);
    flex: none;
  }
  .sim__lgpd a {
    text-decoration: underline;
  }
  .sim__lgpd.is-erro {
    color: #ff8a93;
  }
  .sim__enviar {
    width: 100%;
    justify-content: center;
    margin-top: 18px;
    height: 56px;
  }
  .passos {
    margin-top: 16px;
    font-size: 13.5px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.65);
  }

  @media (max-width: 900px) {
    .sim__in {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .sim__intro {
      position: static;
    }
    .sim__texto {
      font-size: 16px;
    }
    .sim__raul {
      display: none;
    }
    .sim__intro {
      margin-bottom: 8px;
    }
    .sim__card {
      padding: 20px 16px;
      margin: 0 calc(var(--margem) * -0.5);
    }
    .sim__titulo {
      font-size: 36px;
    }
    .sim__resumo {
      display: none;
    }
    .sim__contato {
      grid-template-columns: 1fr;
    }
    .cmp__linha {
      grid-template-columns: 1fr auto;
      row-gap: 6px;
    }
    .cmp__barra {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .res__contato {
      padding: 20px 16px;
      margin: 24px -4px 0;
    }
    .sim__nota-nav {
      display: none;
    }
  }
  /* Resultado */
  .res__rot {
    font-size: 14px;
    font-weight: 600;
    color: #6b6b6f;
  }
  .res__valor {
    margin-top: 4px;
  }
  .res__valor span {
    margin-left: 6px;
    white-space: nowrap;
  }
  .res__valor strong {
    font-size: clamp(32px, 3.4vw, 48px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }
  .res__valor span {
    font-size: 17px;
    font-weight: 500;
    color: #6b6b6f;
  }
  .res__chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
  }
  .res__chips li {
    padding: 6px 12px;
    border-radius: 99px;
    background: #f2f2f4;
    font-size: 13.5px;
    color: #45454a;
  }
  .res__chips b {
    color: #111;
  }
  .res__plano {
    margin-top: 28px;
  }
  .res__trilho {
    position: relative;
    height: 10px;
    border-radius: 99px;
    background: #ececef;
  }
  .res__trilho::before,
  .res__trilho::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #111;
    border: 3px solid var(--branco);
    transform: translateY(-50%);
  }
  .res__trilho::before {
    left: -2px;
  }
  .res__trilho::after {
    right: -2px;
  }
  .res__meta {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 99px;
    background: var(--vermelho);
    transition: left 0.6s var(--ease), width 0.6s var(--ease);
  }
  .res__marcos {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    font-size: 13.5px;
    font-weight: 600;
  }
  .res__marcos span:last-child {
    text-align: right;
  }
  .res__marcos small,
  .res__marco-meta small {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: #8e8e93;
  }
  .res__bandeira {
    position: relative;
    height: 44px;
  }
  .res__marco-meta {
    position: absolute;
    bottom: 8px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--vermelho);
    white-space: nowrap;
  }
  .res__cmp {
    margin-top: 24px;
    display: grid;
    gap: 10px;
  }
  .res__barra {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    font-size: 14px;
  }
  .res__barra div {
    height: 8px;
    border-radius: 99px;
    background: #ececef;
    overflow: hidden;
  }
  .res__barra i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 99px;
    background: #1a8f4a;
    transition: width 0.9s var(--ease);
  }
  .res__barra--fin i {
    background: #8e8e93;
  }
  .res__barra b {
    font-variant-numeric: tabular-nums;
  }
  .res__eco {
    justify-self: start;
    margin-top: 4px;
    padding: 6px 12px;
    border-radius: 99px;
    background: rgba(26, 143, 74, 0.1);
    color: #146c38;
    font-size: 14px;
  }
  .res__dica {
    display: flex;
    align-items: end;
    gap: 10px;
    margin-top: 24px;
  }
  .res__dica img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
  .res__dica p {
    padding: 12px 16px;
    border-radius: 16px 16px 16px 4px;
    background: #f2f2f4;
    font-size: 15px;
    line-height: 1.5;
    color: #2d2d2d;
  }
  .sim .res__zap {
    --bg: #1a8f4a;
    margin-top: 28px;
    height: 54px;
  }
  .sim .res__contato {
    margin: 20px 0 0;
    padding: 0;
    background: none;
    color: #111;
    border-radius: 0;
  }
  .sim .res__zap:hover {
    --bg: #157a3e;
  }
  .res__contato summary {
    list-style: none;
    cursor: pointer;
    font-size: 15px;
    font-weight: 600;
    color: #45454a;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .res__contato summary::-webkit-details-marker {
    display: none;
  }
  .res__contato[open] summary {
    margin-bottom: 16px;
  }
  .sim .res__contato .sim__contato label span {
    color: #45454a;
  }
  .sim .res__contato .sim__contato input {
    background: var(--branco);
    border: 1px solid var(--linha-clara);
    color: #111;
  }
  .sim .res__contato .sim__contato input::placeholder {
    color: #a1a1a6;
  }
  .sim .res__contato .sim__lgpd {
    color: #45454a;
  }
  .sim .sim__res-nota {
    margin-top: 24px;
    font-size: 12.5px;
    color: #8e8e93;
  }
</style>

<script>
  import { modalidades, wa } from "../data/site";

  // Hipóteses de referência (mesma base da calculadora: imóvel 240m / 22%).
  // Confirmar com o Raul as taxas médias por modalidade.
  const REF: Record<string, { prazo: number; taxa: number; faixas: [string, number][] }> = {
    imovel: { prazo: 240, taxa: 0.22, faixas: [["Até R$ 200 mil", 180e3], ["R$ 200 a 400 mil", 300e3], ["R$ 400 a 700 mil", 550e3], ["Acima de R$ 700 mil", 850e3]] },
    veiculo: { prazo: 80, taxa: 0.15, faixas: [["Até R$ 60 mil", 55e3], ["R$ 60 a 120 mil", 90e3], ["R$ 120 a 250 mil", 180e3], ["Acima de R$ 250 mil", 300e3]] },
    pesados: { prazo: 100, taxa: 0.16, faixas: [["Até R$ 300 mil", 250e3], ["R$ 300 a 600 mil", 450e3], ["R$ 600 mil a 1 mi", 800e3], ["Acima de R$ 1 mi", 1.2e6]] },
    servicos: { prazo: 40, taxa: 0.18, faixas: [["Até R$ 20 mil", 18e3], ["R$ 20 a 40 mil", 30e3], ["R$ 40 a 80 mil", 60e3], ["Acima de R$ 80 mil", 100e3]] },
    investimento: { prazo: 200, taxa: 0.2, faixas: [["Até R$ 300 mil", 250e3], ["R$ 300 a 600 mil", 450e3], ["R$ 600 mil a 1 mi", 800e3], ["Acima de R$ 1 mi", 1.2e6]] },
  };

  // Juros mensais de referência do financiamento/crédito equivalente (hipóteses, confirmar com o Raul)
  const FIN: Record<string, number> = { imovel: 0.0095, veiculo: 0.018, pesados: 0.015, servicos: 0.03, investimento: 0.0095 };

  const brl = (v: number) =>
    v.toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
  const arred = (v: number) => Math.round(v / 10) * 10;

  // Indicação de parceiro: link da plataforma com ?ref=CODIGO
  const refUrl = new URLSearchParams(location.search).get("ref");
  if (refUrl) sessionStorage.setItem("raul_ref", refUrl.slice(0, 40));
  const indicacao = sessionStorage.getItem("raul_ref");

  // Ponto único para mandar o lead ao CRM da plataforma (Supabase) quando o backend existir.
  // Defina PUBLIC_LEAD_ENDPOINT no build para ativar; sem ele, o lead segue só pelo WhatsApp.
  async function gravarLead(lead: Record<string, string | null | undefined>) {
    const url = import.meta.env.PUBLIC_LEAD_ENDPOINT;
    if (!url) return;
    try {
      await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(lead), keepalive: true });
    } catch {}
  }

  // Eventos para GA4 (dataLayer) e Meta Pixel, se estiverem instalados
  const track = (ev: string, d: Record<string, unknown> = {}) => {
    const w = window as any;
    w.dataLayer?.push({ event: ev, ...d });
    w.fbq?.("trackCustom", ev, d);
  };

  const form = document.querySelector<HTMLFormElement>("[data-sim]");
  if (form) {
    const ordem = ["objetivo", "valor", "quando", "lance", "resultado"];
    const passos = Object.fromEntries(
      ordem.map((p) => [p, form.querySelector<HTMLElement>(`[data-passo="${p}"]`)!]),
    );
    const num = form.querySelector<HTMLElement>("[data-sim-n]")!;
    const voltar = form.querySelector<HTMLButtonElement>("[data-sim-voltar]")!;
    const etapas = form.querySelectorAll<HTMLElement>(".sim__etapas li");
    const notaNav = form.querySelector<HTMLElement>("[data-sim-nota]");
    const opsValor = form.querySelector<HTMLElement>("[data-ops-valor]")!;
    let atual = 0;

    const val = (n: string) => (form.elements.namedItem(n) as RadioNodeList | null)?.value ?? "";

    function ir(i: number, rolar = true) {
      atual = i;
      ordem.forEach((p, k) => (passos[p].hidden = k !== i));
      const final = i === ordem.length - 1;
      num.textContent = final ? "Resultado" : `Pergunta ${i + 1} de 4`;
      voltar.hidden = i === 0;
      etapas.forEach((el, k) => {
        el.classList.toggle("is-feito", k < i);
        el.classList.toggle("is-atual", k === i);
      });
      if (notaNav) notaNav.hidden = final;
      if (final) calcular();
      const alvo = passos[ordem[i]].querySelector<HTMLElement>("input");
      alvo?.focus({ preventScroll: true });
      // No celular, mantém o card inteiro à vista a cada pergunta
      const r = form!.getBoundingClientRect();
      track("sim_passo", { passo: ordem[i] });
      if (rolar && (r.top < 60 || r.top > innerHeight * 0.4)) {
        window.scrollTo({ top: scrollY + r.top - 76, behavior: "smooth" });
      }
    }

    function montarValores() {
      const ref = REF[val("objetivo")];
      if (!ref) return;
      opsValor.innerHTML = ref.faixas
        .map(
          ([t], k) =>
            `<label class="op"><input type="radio" name="valor" value="${k}" /><span class="op__c"><span class="op__t"><b>${t}</b></span><i class="op__r"></i></span></label>`,
        )
        .join("");
    }

    function calcular() {
      const obj = val("objetivo");
      const ref = REF[obj];
      const credito = ref.faixas[Number(val("valor"))]?.[1] ?? ref.faixas[0][1];
      const base = (credito * (1 + ref.taxa)) / ref.prazo;
      const parcela = `${brl(arred(base * 0.9))} e ${brl(arred(base * 1.1))}`;
      const i = FIN[obj], n = ref.prazo;
      const fin = ((credito * i) / (1 - Math.pow(1 + i, -n))) * n;
      const cons = credito * (1 + ref.taxa);
      const eco = brl(Math.round(Math.max(0, fin - cons) / 1000) * 1000);

      const $r = (k: string) => form!.querySelector<HTMLElement>(`[data-${k}]`)!;
      $r("res-parcela").textContent = parcela;
      $r("res-carta").textContent = brl(credito);
      $r("res-prazo").textContent = `${n} meses`;
      $r("res-fim").textContent = `mês ${n}`;
      // Janela em que a pessoa quer o bem, no trilho do plano
      const janela: Record<string, [number, number]> = { ja: [0, 12], "1-2": [12, 24], "3-5": [36, 60], sem: [60, Math.min(120, n)] };
      const [m0, m1] = janela[val("quando")] ?? [12, 24];
      const ini = Math.min(92, (m0 / n) * 100), larg = Math.max(4, ((Math.min(m1, n) - m0) / n) * 100);
      Object.assign($r("res-meta").style, { left: `${ini}%`, width: `${Math.min(larg, 100 - ini)}%` });
      $r("res-meta-txt").style.left = `${Math.min(ini, 55)}%`;
      $r("cmp-cv").textContent = brl(Math.round(cons / 1000) * 1000);
      $r("cmp-fv").textContent = brl(Math.round(fin / 1000) * 1000);
      $r("cmp-eco").textContent = eco;
      requestAnimationFrame(() => {
        $r("cmp-c").style.width = `${(cons / fin) * 100}%`;
        $r("cmp-f").style.width = "100%";
      });

      const quando = val("quando");
      const lance = val("lance");
      let caminho: string;
      if (quando === "ja" && (lance === "bom" || lance === "bem")) {
        caminho = "Com a reserva que você tem, um lance bem posicionado pode antecipar a contemplação já nos primeiros meses.";
      } else if (quando === "ja") {
        caminho = "Com pressa e pouca reserva, existe o lance embutido. Ele tem um custo, e vale entender com o Raul se compensa.";
      } else if (quando === "1-2") {
        caminho = "Dá para montar um lance programado: você junta a reserva enquanto paga e escolhe a hora de ofertar.";
      } else {
        caminho = "Com tempo a seu favor, o plano pode contar com o sorteio e guardar o lance para quando fizer mais sentido.";
      }
      form!.querySelector("[data-res-caminho]")!.textContent = caminho;

      const mod = modalidades.find((x) => x.id === obj);
      const faixaTxt = ref.faixas[Number(val("valor"))]?.[0];
      const resumo =
        `Olá, Raul. Fiz a simulação no site.\n\n` +
        `Objetivo: ${mod?.nome}\nValor: ${faixaTxt}\nParcela estimada: entre ${parcela} por mês\n\nQuero entender o meu caso.` +
        (indicacao ? `\nIndicação: ${indicacao}` : "");
      form!.querySelector<HTMLAnchorElement>("[data-res-zap]")!.href = wa(resumo);
    }

    form.addEventListener("change", (e) => {
      const t = e.target as HTMLInputElement;
      if (t.type !== "radio") return;
      if (t.name === "objetivo") montarValores();
      setTimeout(() => ir(Math.min(atual + 1, ordem.length - 1)), 260);
    });

    voltar.addEventListener("click", () => ir(Math.max(atual - 1, 0)));

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const nome = form.elements.namedItem("nome") as HTMLInputElement;
      const fone = form.elements.namedItem("fone") as HTMLInputElement;
      let ok = true;
      for (const c of [nome, fone]) {
        const vazio = c.value.trim().length < 2;
        c.setAttribute("aria-invalid", String(vazio));
        if (vazio && ok) {
          c.focus();
          ok = false;
        }
      }
      const lgpd = form.elements.namedItem("lgpd") as HTMLInputElement;
      lgpd.closest("label")!.classList.toggle("is-erro", !lgpd.checked);
      if (ok && !lgpd.checked) {
        lgpd.focus();
        ok = false;
      }
      if (!ok) return;
      track("sim_envio", { objetivo: val("objetivo") });
      track("Lead");
      const m = modalidades.find((x) => x.id === val("objetivo"));
      const cfg = REF[val("objetivo")];
      const faixa = cfg.faixas[Number(val("valor"))]?.[0];
      const quandoTxt = (form.querySelector(`input[name="quando"]:checked + .op__c b`) as HTMLElement)?.textContent;
      const lanceTxt = (form.querySelector(`input[name="lance"]:checked + .op__c b`) as HTMLElement)?.textContent;
      gravarLead({
        nome: nome.value.trim(),
        whatsapp: fone.value.trim(),
        objetivo: m?.nome,
        valor: faixa,
        prazo: quandoTxt,
        lance: lanceTxt,
        indicadoPor: indicacao,
        origem: "lp-simulacao",
      });
      const msg =
        `Olá, Raul. Sou ${nome.value.trim()} e fiz a simulação no site.\n\n` +
        `Objetivo: ${m?.nome}\nValor: ${faixa}\nPrazo: ${quandoTxt}\nReserva para lance: ${lanceTxt}\n\n` +
        `Meu WhatsApp: ${fone.value.trim()}` +
        (indicacao ? `\nIndicação: ${indicacao}` : "");
      window.open(wa(msg), "_blank", "noopener");
    });

    // Frase viva do lado esquerdo: cada resposta preenche uma lacuna; tocar numa lacuna volta à pergunta.
    const lacunas = [...document.querySelectorAll<HTMLButtonElement>("[data-lacuna]")];
    const vazio = lacunas.map((l) => l.textContent || "");
    const OBJ: Record<string, string> = {
      imovel: "um imóvel",
      veiculo: "um veículo",
      pesados: "um caminhão ou máquina",
      servicos: "um serviço planejado",
      investimento: "um investimento",
    };
    const LANCE: Record<string, string> = {
      nao: "nenhuma reserva para lance ainda",
      pouco: "um pouco de reserva para lance",
      bom: "uma boa reserva para lance",
      bem: "um bem para usar no lance",
    };
    const rotulo = (n: string) =>
      (form.querySelector(`input[name="${n}"]:checked + .op__c b`) as HTMLElement | null)?.textContent?.trim() || "";
    function frase() {
      const q = rotulo("quando");
      void q;
      const txt = [rotulo("objetivo"), rotulo("valor"), rotulo("quando"), rotulo("lance")];
      let primeiraVazia = -1;
      lacunas.forEach((l, k) => {
        const cheia = !!txt[k];
        l.textContent = cheia ? txt[k] : vazio[k];
        l.classList.toggle("is-cheia", cheia);
        if (!cheia && primeiraVazia < 0) primeiraVazia = k;
        l.tabIndex = cheia ? 0 : -1;
      });
      lacunas.forEach((l, k) => l.classList.toggle("is-atual", k === primeiraVazia && atual === k));
      const barra = form.querySelector<HTMLElement>("[data-sim-barra]");
      if (barra) barra.style.width = `${Math.max(6, (atual / 4) * 100)}%`;
    }
    form.addEventListener("change", () => setTimeout(frase, 0));
    lacunas.forEach((l, k) => l.addEventListener("click", () => l.classList.contains("is-cheia") && ir(k)));
    const irOriginal = ir;
    ir = ((i: number, rolar = true) => {
      irOriginal(i, rolar);
      frase();
    }) as typeof ir;
    frase();

    const tipo = new URLSearchParams(location.search).get("tipo");
    if (tipo) {
      const r = form.querySelector<HTMLInputElement>(`input[name="objetivo"][value="${CSS.escape(tipo)}"]`);
      if (r) {
        r.checked = true;
        montarValores();
        ir(1, false);
      }
    }

    // Links "Simular imóvel" etc. pré-selecionam o objetivo
    document.querySelectorAll<HTMLAnchorElement>("[data-objetivo]").forEach((a) =>
      a.addEventListener("click", () => {
        const r = form.querySelector<HTMLInputElement>(`input[name="objetivo"][value="${a.dataset.objetivo}"]`);
        if (!r) return;
        r.checked = true;
        montarValores();
        ir(1);
      }),
    );
  }
</script>
