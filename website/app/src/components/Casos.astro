---
// O cliente pensa no problema, não no tipo de consórcio. Cada caso abre a simulação já com o objetivo marcado.
import Seta from "./Seta.astro";
const casos = [
  { obj: "imovel", t: "Quero sair do aluguel", d: "Trocar o aluguel por uma parcela que vira imóvel seu." },
  { obj: "imovel", t: "Tenho financiamento e pago juros demais", d: "Ver se vale trocar a dívida por uma carta sem juros." },
  { obj: "veiculo", t: "Quero trocar de carro sem dívida", d: "Planejar a troca usando o carro atual como lance." },
  { obj: "investimento", t: "Quero investir em imóveis", d: "Usar a carta para comprar ativos que geram renda." },
];
---

<section class="casos" id="casos">
  <div class="wrap">
    <p class="rotulo" data-reveal><b>03</b> Seu caso</p>
    <h2 class="display d-m casos__titulo" data-split>
      <span class="linha"><span>Qual é o seu momento?</span></span>
    </h2>
    <p class="casos__sub" data-reveal>Escolha o que mais parece com você. A simulação já começa daí.</p>

    <div class="casos__grade">
      {
        casos.map((c, i) => (
          <a href="#simulacao" class="caso" data-objetivo={c.obj} data-reveal>
            <span class="caso__n">0{i + 1}</span>
            <h3>{c.t}</h3>
            <p>{c.d}</p>
            <span class="caso__cta">
              Simular este caso
              <Seta />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .casos {
    background: var(--papel);
    color: #111;
    padding: clamp(96px, 14vh, 160px) 0;
  }
  .casos .rotulo {
    color: #6b6b6f;
  }
  .casos__titulo {
    margin-top: 24px;
  }
  .casos__sub {
    margin-top: 16px;
    color: #45454a;
  }
  .casos__grade {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 48px;
  }
  .caso {
    display: flex;
    flex-direction: column;
    min-height: 280px;
    padding: 24px;
    border-radius: 16px;
    background: var(--branco);
    box-shadow: 0 1px 0 var(--linha-clara);
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), background-color 0.3s;
  }
  .caso:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px -28px rgba(0, 0, 0, 0.3);
  }
  .caso__n {
    font-size: 13px;
    font-weight: 600;
    color: var(--vermelho);
  }
  .caso h3 {
    margin-top: auto;
    font-size: clamp(21px, 1.7vw, 26px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .caso p {
    margin-top: 10px;
    font-size: 15px;
    color: #55555a;
  }
  .caso__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    font-size: 14px;
    font-weight: 600;
    color: var(--vermelho);
  }
  .caso:hover :global(.btn__seta) {
    transform: translate(3px, -3px);
  }
  @media (max-width: 1000px) {
    .casos__grade {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .casos__grade {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .caso {
      min-height: 0;
      padding: 20px;
    }
    .caso h3 {
      margin-top: 12px;
    }
  }
</style>
