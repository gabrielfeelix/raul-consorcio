---
import { INSTAGRAM, wa } from "../data/site";
import Onda from "./Onda.astro";
import Seta from "./Seta.astro";
const ano = new Date().getFullYear();
---

<footer class="rod">
  <div class="wrap">
    <div class="rod__cta">
      <h2 class="display d-m" data-split>
        <span class="linha"><span>Seu patrimônio</span></span>
        <span class="linha"><span>começa numa conversa.</span></span>
      </h2>
      <div class="rod__acoes" data-reveal>
        <a href="#simulacao" class="btn"><Onda texto="Fazer simulação" /><Seta /></a>
        <a href={wa("Olá, Raul. Vim pelo site e quero conversar sobre consórcio.")} target="_blank" rel="noopener" class="btn btn--fantasma">
          <Onda texto="Chamar no WhatsApp" />
        </a>
      </div>
    </div>

    <div class="rod__links">
      <a href={INSTAGRAM} target="_blank" rel="noopener"><Onda texto="Instagram" /></a>
      <a href="#simulacao"><Onda texto="Simulação" /></a>
      <a href="#faq"><Onda texto="Dúvidas" /></a>
      <span>Presencial e online, em todo o Brasil</span>
    </div>

    <p class="rod__marca display" data-rod-marca aria-hidden="true">Raul Carvalho</p>

    <div class="rod__legal">
      <span>© {ano} Raul Carvalho Consórcios. CNPJ 00.000.000/0000-00</span>
      <span>Consórcio é regulado pelo Banco Central do Brasil. Simulações são estimativas e não constituem oferta. <a href="/privacidade">Privacidade</a></span>
    </div>
  </div>
</footer>

<style>
  .rod {
    padding: clamp(56px, 8vh, 88px) 0 28px;
    background: var(--preto);
    border-top: 1px solid var(--linha);
    overflow: hidden;
  }
  .rod__cta {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 32px;
    flex-wrap: wrap;
  }
  .rod__cta h2 {
    max-width: 11em;
  }
  .rod__acoes {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .rod__links {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    margin: clamp(72px, 12vh, 140px) 0 28px;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.72);
  }
  .rod__links span {
    margin-left: auto;
    color: var(--cinza);
  }
  .rod__marca {
    margin: 0;
    padding: 0.08em 0 0.12em;
    font-size: 9vw;
    line-height: 0.9;
    white-space: nowrap;
    letter-spacing: -0.06em;
    border-top: 1px solid var(--linha);
    border-bottom: 1px solid var(--linha);
  }
  .rod__marca span {
    color: var(--vermelho);
  }
  @media (min-width: 1440px) {
    .rod__marca {
      font-size: 130px;
    }
  }
  .rod__legal {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 20px;
    font-size: 12px;
    color: var(--cinza);
  }
  @media (max-width: 700px) {
    .rod__links span {
      margin-left: 0;
    }
    .rod__acoes {
      flex-direction: column;
      width: 100%;
    }
    .rod__acoes .btn {
      justify-content: center;
    }
  }
</style>
