---
// Um player só + índice tipográfico (em vez de carrossel de cards iguais).
// O embed do Instagram é recortado para mostrar só o vídeo (mesmo truque do Reel.astro).
import { INSTAGRAM } from "../data/site";
import Seta from "./Seta.astro";
const reels = [
  ["DaLCY9Js1IL", "O que é consórcio?"],
  ["Db5fcsJspK0", "Como funciona o lance"],
  ["Da0bcOAMg4C", "Trocar financiamento por consórcio"],
];
---

<section class="vid" id="videos">
  <div class="wrap vid__in">
    <div class="vid__player">
      <div class="vid__tela">
        <iframe
          data-vid-frame
          src={`https://www.instagram.com/p/${reels[0][0]}/embed/`}
          title={reels[0][1]}
          loading="lazy"
          scrolling="no"
          allowfullscreen></iframe>
      </div>
    </div>

    <div class="vid__indice">
      <h2 class="display vid__titulo" data-split>
        <span class="linha"><span>Ficou com dúvida?</span></span>
        <span class="linha"><span>O Raul explica</span></span>
        <span class="linha"><span>em um minuto.</span></span>
      </h2>
      <ul class="vid__lista">
        {
          reels.map(([c, t], i) => (
            <li>
              <button type="button" data-vid={c} aria-pressed={i === 0 ? "true" : "false"}>
                {t}
              </button>
            </li>
          ))
        }
      </ul>
      <a href={INSTAGRAM} target="_blank" rel="noopener" class="vid__mais">Ver todos no Instagram<Seta /></a>
    </div>
  </div>
</section>

<script>
  const frame = document.querySelector<HTMLIFrameElement>("[data-vid-frame]");
  const botoes = [...document.querySelectorAll<HTMLButtonElement>("[data-vid]")];
  botoes.forEach((b) =>
    b.addEventListener("click", () => {
      if (!frame) return;
      frame.src = `https://www.instagram.com/p/${b.dataset.vid}/embed/`;
      frame.title = b.textContent?.trim() || "";
      botoes.forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
    }),
  );
</script>

<style>
  .vid {
    background: var(--vinho);
    color: var(--branco);
    padding: clamp(64px, 9vh, 104px) 0;
  }
  .vid__in {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(32px, 7vw, 128px);
    align-items: center;
  }
  .vid__player {
    width: min(340px, 80vw);
  }
  .vid__tela {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 18px;
    overflow: hidden;
    background: #1a0606;
  }
  .vid__tela iframe {
    position: absolute;
    top: -56px;
    left: 50%;
    transform: translateX(-50%);
    width: 178%;
    height: 1200px;
    border: 0;
  }
  .vid__titulo {
    font-size: clamp(34px, 3.6vw, 60px);
  }
  .vid__lista {
    list-style: none;
    margin: clamp(28px, 5vh, 48px) 0 0;
    padding: 0;
  }
  .vid__lista button {
    display: block;
    width: 100%;
    padding: 14px 0;
    font: inherit;
    font-size: clamp(20px, 1.9vw, 30px);
    font-weight: 500;
    letter-spacing: -0.03em;
    text-align: left;
    color: rgba(255, 255, 255, 0.45);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color 0.3s var(--ease), transform 0.5s var(--ease);
  }
  .vid__lista button:hover {
    color: rgba(255, 255, 255, 0.8);
  }
  .vid__lista button[aria-pressed="true"] {
    color: var(--branco);
    transform: translateX(14px);
  }
  .vid__mais {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    font-size: 15px;
    font-weight: 600;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    padding-bottom: 3px;
  }
  @media (max-width: 860px) {
    .vid__in {
      grid-template-columns: 1fr;
    }
    .vid__indice {
      order: -1;
    }
    .vid__player {
      width: min(300px, 78vw);
    }
    .vid__lista button {
      padding: 10px 0;
    }
  }
</style>
