---
import Onda from "./Onda.astro";
import { wa } from "../data/site";
interface Props {
  links?: string[][];
}
const padrao = [
  ["#consultor", "Quem é o Raul"],
  ["#construcao", "Como funciona"],
  ["#com-raul", "Com o Raul"],
  ["#simulacao", "Simulação"],
  ["#faq", "Dúvidas"],
];
const zap = wa("Oi Raul! Vim pelo site e queria conversar sobre consórcio.");
const { links = padrao } = Astro.props;
---

<header class="nav" data-nav>
  <div class="nav__in wrap">
    <a href="#topo" class="nav__logo" aria-label="Raul Carvalho, início">
      <img src="/marca/rc.svg" alt="" width="30" height="30" />
      <span>Raul Carvalho</span>
    </a>
    <nav class="nav__links" aria-label="Seções">
      {links.map(([href, t]) => <a href={href}><Onda texto={t} /></a>)}
    </nav>
    <a href={zap} target="_blank" rel="noopener" class="btn nav__cta">
      <svg class="nav__zap" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2Zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 4.54 0 8.24 3.7 8.24 8.24 0 4.55-3.7 8.24-8.24 8.24Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.16.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/></svg>
      <Onda texto="WhatsApp" />
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: transform 0.6s var(--ease), background-color 0.4s var(--ease);
  }
  .nav.is-solid {
    background: rgba(11, 11, 12, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--linha);
  }
  .nav.is-hidden {
    transform: translateY(-100%);
  }
  .nav__in {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 76px;
  }
  .nav__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .nav__logo img {
    height: 30px;
    width: 30px;
  }
  .nav__links {
    display: flex;
    gap: 30px;
    margin-left: auto;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.72);
  }
  .nav__links a:hover {
    color: var(--branco);
  }
  .nav__cta {
    --bg: #1a8f4a;
    height: 42px;
    padding: 0 18px;
    font-size: 14px;
    gap: 8px;
  }
  .nav__cta:hover {
    --bg: #157a3e;
  }
  .nav__zap {
    width: 18px;
    height: 18px;
    flex: none;
  }
  @media (max-width: 900px) {
    .nav__links {
      display: none;
    }
    .nav__cta {
      margin-left: auto;
      height: 38px;
      padding: 0 14px;
    }
    .nav__in {
      height: 64px;
    }
  }
</style>
