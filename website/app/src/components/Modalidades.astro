---
import { modalidades } from "../data/site";
import Seta from "./Seta.astro";
const linhas = ["Cada objetivo", "pede um plano", "diferente."];
---

<section class="mod" id="modalidades">
  <div class="wrap">
    <h2 class="mod__escada display d-l">
      {
        linhas.map((l, i) => (
          <span class="mod__degrau" style={`--d:${i}`}>
            <span data-fill-line>{l}</span>
          </span>
        ))
      }
    </h2>

    <div class="mod__corpo">
      <div>
        <p class="mod__sub" data-reveal>O Raul trabalha com todos os tipos de consórcio. Escolha o seu para simular.</p>
        <ul class="mod__lista" data-mod-lista>
          {
            modalidades.map((m, i) => (
              <li data-reveal>
                <a href="#simulacao" class="tipo" data-objetivo={m.id} data-mod-i={i}>
                  <img class="tipo__mini" src={`/img/mod/${m.id}.webp`} alt="" loading="lazy" />
                  <span class="tipo__txt">
                    <span class="tipo__nome">{m.nome}</span>
                    <span class="tipo__usos">{m.usos.slice(0, 3).map((u, k) => (k ? u[0].toLowerCase() + u.slice(1) : u)).join(", ")}</span>
                  </span>
                  <span class="tipo__ir" aria-hidden="true">
                    <Seta />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="mod__foto" aria-hidden="true">
        <div class="mod__imgs">
          {modalidades.map((m, i) => <img src={`/img/mod/${m.id}.webp`} alt="" loading="lazy" class={i === 0 ? "is-on" : ""} />)}
        </div>
        <figcaption>
          {modalidades.map((m, i) => <span class={i === 0 ? "is-on" : ""}>{m.frase}</span>)}
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  const lista = document.querySelector("[data-mod-lista]");
  const imgs = [...document.querySelectorAll(".mod__imgs img")];
  const frases = [...document.querySelectorAll(".mod__foto figcaption span")];
  const mostrar = (i: number) => {
    imgs.forEach((im, k) => im.classList.toggle("is-on", k === i));
    frases.forEach((f, k) => f.classList.toggle("is-on", k === i));
  };
  lista?.querySelectorAll<HTMLElement>("[data-mod-i]").forEach((a) => {
    const i = Number(a.dataset.modI);
    a.addEventListener("mouseenter", () => mostrar(i));
    a.addEventListener("focus", () => mostrar(i));
  });
</script>

<style>
  .mod {
    background: var(--papel);
    color: #111;
    padding: clamp(72px, 10vh, 120px) 0;
  }
  .mod__escada {
    margin: 0 0 clamp(48px, 7vh, 80px);
  }
  .mod__degrau {
    display: block;
    padding: 0.06em 0 0.1em calc(var(--d) * 1.2em);
    border-bottom: 1px solid var(--linha-clara);
  }
  .mod__degrau > span {
    display: inline-block;
    padding: 0 0.04em 0.16em 0;
    margin-bottom: -0.16em;
    background: linear-gradient(90deg, #111 var(--p, 100%), #c3c3c7 var(--p, 100%));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .mod__corpo {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 6vw, 112px);
    align-items: start;
  }
  .mod__sub {
    font-size: 17px;
    color: #45454a;
    max-width: 30em;
    margin-bottom: 28px;
  }
  .mod__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--linha-clara);
  }
  .tipo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    padding: 22px 0;
    border-top: 1px solid var(--linha-clara);
  }
  .tipo__mini {
    display: none;
  }
  .tipo__nome {
    display: block;
    font-size: clamp(34px, 3.6vw, 56px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    transition: transform 0.6s var(--ease), color 0.3s var(--ease);
  }
  .tipo__usos {
    display: block;
    margin-top: 8px;
    font-size: 14px;
    color: #6b6b6f;
    transition: transform 0.6s var(--ease);
  }
  .tipo__ir {
    color: var(--vermelho);
    opacity: 0.35;
    transition: opacity 0.3s var(--ease);
  }
  .tipo:hover .tipo__nome,
  .tipo:focus-visible .tipo__nome {
    color: var(--vermelho);
    transform: translateX(10px);
  }
  .tipo:hover .tipo__usos,
  .tipo:focus-visible .tipo__usos {
    transform: translateX(10px);
  }
  .tipo:hover .tipo__ir,
  .tipo:focus-visible .tipo__ir {
    opacity: 1;
  }
  .tipo:hover :global(.btn__seta) {
    transform: translate(3px, -3px);
  }
  .tipo:focus-visible {
    outline: 3px solid var(--vermelho);
    outline-offset: 4px;
  }
  .mod__foto {
    position: sticky;
    top: 110px;
    margin: 0;
  }
  .mod__imgs {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    overflow: hidden;
    background: var(--preto);
  }
  .mod__imgs img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 0.5s var(--ease), transform 1.2s var(--ease);
  }
  .mod__imgs img.is-on {
    opacity: 1;
    transform: none;
  }
  .mod__foto figcaption {
    display: grid;
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.45;
    color: #45454a;
  }
  .mod__foto figcaption span {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .mod__foto figcaption span.is-on {
    opacity: 1;
  }
  @media (max-width: 900px) {
    .mod__corpo {
      grid-template-columns: minmax(0, 1fr);
    }
    .mod__foto {
      display: none;
    }
    .mod__sub {
      font-size: 16px;
    }
    .tipo {
      grid-template-columns: 64px minmax(0, 1fr) auto;
      gap: 16px;
      padding: 16px 0;
    }
    .tipo__mini {
      display: block;
      width: 64px;
      height: 64px;
      border-radius: 10px;
      object-fit: cover;
    }
    .tipo__nome {
      font-size: 28px;
    }
    .tipo__usos {
      margin-top: 4px;
      font-size: 13px;
    }
    .tipo__ir {
      opacity: 1;
    }
  }
</style>
