---
import Seta from "./Seta.astro";
// O monograma RC se desenha enquanto a página rola: o arco do C fecha em três trechos
// (uma etapa cada), o Raul vai na ponta da caneta e o R entra no fim como o patrimônio.
// Monograma provisório até a logo final (marca/rc-branco.svg usa o mesmo desenho).
interface Props {
  titulo?: string;
}
const { titulo = "Como funciona o consórcio." } = Astro.props;
const etapas = [
  {
    t: "A carta",
    d: "Você define o patrimônio que quer construir. A carta de crédito é o valor dele: imóvel, veículo, máquina ou investimento.",
    tag: "Carta",
    medida: "o valor do seu bem",
  },
  {
    t: "As parcelas",
    d: "Sem juros. Uma taxa de administração diluída no prazo, num valor que cabe no seu mês sem apertar o resto.",
    tag: "Parcelas",
    medida: "sem juros, no prazo",
  },
  {
    t: "A contemplação",
    d: "Por sorteio ou por lance (uma oferta para ser contemplado antes). Com estratégia de lance, você deixa de esperar a sorte e passa a planejar a data.",
    tag: "Contemplação",
    medida: "por sorteio ou lance",
  },
];
---

<section class="build" id="construcao" data-build>
  <div class="build__in wrap">
    <div class="build__col">
      <h2 class="display d-m build__titulo">{titulo}</h2>
      <ol class="build__etapas">
        {
          etapas.map((e, i) => (
            <li class="build__etapa" data-etapa={i}>
              <div>
                <h3>{e.t}</h3>
                <p>{e.d}</p>
              </div>
            </li>
          ))
        }
      </ol>


    </div>

    <div class="build__palco">
      <div class="build__quadro">
        <span class="build__nome-quadro">Seu plano</span>
        <svg viewBox="-34 -10 176 140" class="build__svg" role="img" aria-label="Monograma do Raul Carvalho sendo desenhado em três etapas">
          <defs>
            <pattern id="pontos" width="4" height="4" patternUnits="userSpaceOnUse">
              <circle cx="0.5" cy="0.5" r="0.22" fill="rgba(255,255,255,.12)"></circle>
            </pattern>
          </defs>
          <rect x="-34" y="-10" width="176" height="140" fill="url(#pontos)"></rect>
          <circle cx="60" cy="60" r="40" class="arco__guia" />
          <line x1="60" y1="-10" x2="60" y2="130" class="arco__eixo" />
          <line x1="-34" y1="60" x2="142" y2="60" class="arco__eixo" />
          <path d="M88.28 31.72A40 40 0 0 0 32.21 31.23" class="arco__seg" pathLength="1" data-seg="0" />
          <path d="M31.23 32.21A40 40 0 0 0 31.23 87.79" class="arco__seg" pathLength="1" data-seg="1" />
          <path d="M32.21 88.77A40 40 0 0 0 88.28 88.28" class="arco__seg" pathLength="1" data-seg="2" />
          <g class="arco__r">
            <path d="M46 38H66A14 14 0 0 1 66 66H56V82H46ZM56 47V57H65A5 5 0 0 0 65 47Z" fill-rule="evenodd" />
            <path d="M58.5 63H70.5L81.5 82H69.5Z" />
          </g>
          <g class="arco__rot" data-rot="0">
            <line x1="60" y1="14" x2="60" y2="8" class="arco__tick" />
            <text x="60" y="-0.5" text-anchor="middle">{etapas[0].tag}</text>
            <text x="60" y="4.2" text-anchor="middle" class="arco__sub">{etapas[0].medida}</text>
          </g>
          <g class="arco__rot" data-rot="1">
            <line x1="14" y1="60" x2="8" y2="60" class="arco__tick" />
            <text x="5" y="59.2" text-anchor="end">{etapas[1].tag}</text>
            <text x="5" y="63.6" text-anchor="end" class="arco__sub">{etapas[1].medida}</text>
          </g>
          <g class="arco__rot" data-rot="2">
            <line x1="60" y1="106" x2="60" y2="112" class="arco__tick" />
            <text x="60" y="118.5" text-anchor="middle">{etapas[2].tag}</text>
            <text x="60" y="122.8" text-anchor="middle" class="arco__sub">{etapas[2].medida}</text>
          </g>
          <g class="arco__fim">
            <line x1="84" y1="60" x2="94" y2="60" class="arco__tick" />
            <text x="97" y="61.4">Seu patrimônio</text>
          </g>

          <g class="cursor cursor--raul" data-cursor="raul">
            <path d="M0 0 L0 7.2 L2 5.3 L3.4 8.4 L4.6 7.9 L3.3 4.9 L6 4.9 Z" class="cursor__seta"></path>
            <g transform="translate(4.6 8.6)">
              <rect width="9.6" height="4" rx="0.8" class="cursor__pill"></rect>
              <text x="4.8" y="2.85" text-anchor="middle" class="cursor__nome">Raul</text>
            </g>
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .build {
    position: relative;
    background: var(--preto);
  }
  .build__in {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    min-height: 100svh;
    padding-top: 100px;
    padding-bottom: 48px;
  }
  .build__titulo {
    margin: 0 0 40px;
    max-width: 9em;
  }
  .build__etapas {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .build__etapa {
    display: grid;
    padding: 22px 0;
    border-top: 1px solid var(--linha);
    opacity: 0.32;
    transition: opacity 0.5s var(--ease);
  }
  .build__etapa.is-ativa {
    opacity: 1;
  }
  .build__etapa h3 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 6px;
  }
  .build__etapa p {
    color: rgba(255, 255, 255, 0.68);
    font-size: 15px;
    max-width: 30em;
  }
  .build__fim {
    margin-top: 28px;
    padding: 20px 22px;
    border-radius: var(--raio);
    background: var(--vermelho);
  }
  .build__fim-t {
    font-size: clamp(20px, 1.8vw, 26px);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .build__fim-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 14px;
    font-weight: 600;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    padding-bottom: 2px;
  }
  .build__fim-d {
    margin-top: 6px;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.85);
  }
  :global(html.js-motion) .build__fim {
    opacity: 0;
    transform: translateY(16px);
  }
  .build__cta {
    margin-top: 28px;
  }
  .build__quadro {
    position: relative;
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    background: var(--preto-2);
    overflow: hidden;
  }
  .build__nome-quadro {
    position: absolute;
    top: 14px;
    left: 16px;
    font-size: 12px;
    font-weight: 500;
    color: var(--cinza);
    z-index: 1;
  }
  .build__svg {
    width: 100%;
    height: auto;
    max-height: 74svh;
  }
  .arco__guia,
  .arco__eixo {
    fill: none;
    stroke: rgba(255, 255, 255, 0.12);
    stroke-width: 0.25;
    stroke-dasharray: 1 1.2;
  }
  .arco__seg {
    fill: none;
    stroke: var(--vermelho);
    stroke-width: 9;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .arco__r {
    fill: var(--branco);
  }
  .arco__tick {
    stroke: rgba(255, 255, 255, 0.45);
    stroke-width: 0.25;
  }
  .arco__rot text,
  .arco__fim text {
    fill: var(--branco);
    font-size: 4.2px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .arco__rot .arco__sub {
    fill: rgba(255, 255, 255, 0.5);
    font-size: 2.8px;
    font-weight: 500;
    letter-spacing: 0;
  }

  /* Cursor */
  .cursor__seta {
    stroke: var(--branco);
    stroke-width: 0.35;
    stroke-linejoin: round;
  }
  .cursor--raul .cursor__seta,
  .cursor--raul .cursor__pill {
    fill: var(--vermelho);
  }
  .cursor__nome {
    fill: var(--branco);
    font-size: 2.4px;
    font-weight: 600;
  }

  /* Estado final sem JS / movimento reduzido */
  .cursor {
    opacity: 0;
  }
  :global(html:not(.js-motion)) .build__etapa {
    opacity: 1;
  }

  @media (max-width: 860px) {
    .build__in {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 20px;
      padding-top: 92px;
    }
    .build__palco {
      order: -1;
    }
    .build__svg {
      max-height: 38svh;
    }
    .arco__rot text,
    .arco__fim text {
      font-size: 6.4px;
    }
    .arco__rot .arco__sub,
    .arco__fim {
      display: none;
    }
    .build__cta {
      display: none;
    }
    .build__titulo {
      margin: 0 0 16px;
      font-size: 30px;
    }
    :global(html.js-motion) .build__etapa:not(.is-ativa) {
      display: none;
    }
    :global(html.js-motion) .build__etapa {
      border-top: 0;
      padding-top: 0;
    }
  }
</style>
