---
// Como funciona o consórcio: linha do tempo com ícones simples.
// Cada etapa traz o termo técnico (mostra que o Raul é do ramo) e, ao lado,
// o que ele quer dizer em linguagem de todo dia. A linha se preenche ao rolar.
interface Props {
  titulo?: string;
}
const { titulo = "Como funciona o consórcio." } = Astro.props;
const passos = [
  {
    icone: "alvo",
    t: "Você escolhe o valor do bem",
    termo: "Carta de crédito",
    d: "É o valor do que você quer comprar: a casa, o carro, a máquina.",
  },
  {
    icone: "calendario",
    t: "Paga uma parcela por mês",
    termo: "Sem juros de banco",
    d: "Tem só a taxa de administração, que é o pagamento da empresa do consórcio, já somada na parcela.",
  },
  {
    icone: "sorteio",
    t: "Todo mês tem sorteio",
    termo: "Assembleia",
    d: "É o encontro mensal do grupo. Nele acontece o sorteio e quem quiser pode dar um lance.",
  },
  {
    icone: "dinheiro",
    t: "Sorteado ou com lance, você recebe",
    termo: "Contemplação",
    d: "É quando o dinheiro sai para você. O lance é uma entrada que você oferece para sair antes, sem depender da sorte.",
  },
  {
    icone: "chave",
    t: "Compra à vista e segue pagando",
    termo: "O bem já é seu",
    d: "Você compra à vista e usa desde o primeiro dia. As parcelas continuam até o fim do plano.",
  },
];
const icones: Record<string, string> = {
  alvo: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="0.8" fill="currentColor"/>',
  calendario: '<rect x="4" y="5.5" width="16" height="14" rx="2.5"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4"/>',
  sorteio: '<circle cx="12" cy="12" r="8"/><path d="M8.5 12.5l2.3 2.3 4.7-5"/>',
  dinheiro: '<rect x="3.5" y="7" width="17" height="10" rx="2"/><circle cx="12" cy="12" r="2.4"/><path d="M6.5 10v4M17.5 10v4"/>',
  chave: '<circle cx="8.5" cy="12" r="4"/><path d="M12.5 12H20.5M17.5 12v3M20 12v2"/>',
};
---

<section class="build" id="construcao" data-build>
  <div class="build__in wrap">
    <div class="build__col">
      <h2 class="display build__titulo" data-split>
        <span class="linha"><span>{titulo}</span></span>
      </h2>
      <p class="build__sub" data-reveal>
        Um grupo de pessoas junta dinheiro todo mês. A cada mês, alguém do grupo recebe o valor para comprar o seu bem,
        até que todos recebam.
      </p>
    </div>

    <ol class="tl" data-tl>
      <span class="tl__trilho" aria-hidden="true"><i data-tl-progresso></i></span>
      {
        passos.map((p) => (
          <li class="tl__passo" data-tl-passo>
            <span class="tl__icone" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={icones[p.icone]} />
            </span>
            <div>
              <h3>{p.t}</h3>
              <p>
                <b>{p.termo}:</b> {p.d}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .build {
    background: var(--preto);
  }
  .build__in {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 112px);
    align-items: start;
    padding-top: clamp(72px, 10vh, 120px);
    padding-bottom: clamp(72px, 10vh, 120px);
  }
  .build__col {
    position: sticky;
    top: 110px;
  }
  .build__titulo {
    font-size: clamp(36px, 4vw, 64px);
  }
  .build__sub {
    margin-top: 20px;
    max-width: 24em;
    font-size: 17px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
  }
  .tl {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 30px;
  }
  .tl__trilho {
    position: absolute;
    left: 23px;
    top: 24px;
    bottom: 24px;
    width: 2px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }
  .tl__trilho i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--vermelho);
    transform-origin: 50% 0;
  }
  .tl__passo {
    position: relative;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }
  .tl__icone {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #1c1c1f;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--branco);
    transition:
      background-color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .tl__icone svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tl__passo.is-on .tl__icone {
    background: var(--vermelho);
    border-color: var(--vermelho);
  }
  .tl__passo h3 {
    padding-top: 4px;
    font-size: clamp(19px, 1.6vw, 24px);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .tl__passo p {
    margin-top: 6px;
    max-width: 30em;
    font-size: 15.5px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.7);
  }
  .tl__passo p b {
    font-weight: 600;
    color: var(--branco);
  }
  @media (max-width: 860px) {
    .build__in {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .build__col {
      position: static;
    }
    .build__titulo {
      font-size: 34px;
    }
    .build__sub {
      font-size: 16px;
    }
    .tl {
      gap: 26px;
    }
    .tl__passo {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 16px;
    }
    .tl__icone {
      width: 44px;
      height: 44px;
    }
    .tl__trilho {
      left: 21px;
    }
  }
</style>
