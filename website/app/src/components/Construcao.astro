---
// Como funciona o consórcio, em cena de cinema.
// Ao chegar, a foto (uma casa real) abre até ocupar a tela e fica parada enquanto a pessoa
// rola: cada trecho de rolagem é uma etapa. A câmera se move devagar com a rolagem e o
// letreiro (texto grande, direto sobre a foto, sem cartão) troca palavra por palavra.
// As pílulas em cima mostram a etapa e levam até ela. Termo técnico na pílula,
// explicação simples no letreiro.
interface Props {
  titulo?: string;
  modelo?: string; // mantido por compatibilidade com as páginas de modelos
}
const { titulo = "Como funciona o consórcio." } = Astro.props;
const etapas = [
  {
    termo: "Carta de crédito",
    grande: "R$ 300 mil para a sua casa.",
    d: "Carta de crédito é o valor do bem que você quer comprar. Você escolhe esse valor no começo.",
  },
  {
    termo: "Parcela",
    grande: "Uma parcela por mês, sem juros.",
    d: "Todo mundo do grupo paga. Não tem juros de banco: só a taxa de administração, que é o pagamento da empresa do consórcio, já somada na parcela.",
  },
  {
    termo: "Assembleia",
    grande: "Todo mês, um sorteio.",
    d: "Assembleia é o encontro do grupo uma vez por mês. É nela que alguém é sorteado para receber o valor.",
  },
  {
    termo: "Contemplação",
    grande: "Um dia, sai para você.",
    d: "Contemplação é quando o dinheiro sai. Pode ser por sorteio ou por lance, que é uma entrada que você oferece para receber antes.",
  },
  {
    termo: "Compra à vista",
    grande: "A chave é sua.",
    d: "Você compra à vista e já usa o bem. As parcelas continuam até o fim do plano.",
  },
];
---

<section class="como" id="construcao" data-como>
  <div class="wrap como__topo">
    <h2 class="display como__titulo" data-split>
      <span class="linha"><span>{titulo}</span></span>
    </h2>
    <p class="como__frase" data-reveal>Um grupo junta dinheiro todo mês. A cada mês, alguém recebe. Até todo mundo receber.</p>
  </div>

  <div class="filme" data-filme style={`--n:${etapas.length}`}>
    <div class="filme__fixo">
      <div class="cena" data-cena>
        <picture>
          <source media="(max-width: 700px)" srcset="/img/casa-cena-m.webp" />
          <img src="/img/casa-cena.webp" alt="Casa iluminada ao entardecer" width="1600" height="1067" loading="lazy" decoding="async" />
        </picture>

        <nav class="pilulas" aria-label="Etapas do consórcio">
          {
            etapas.map((e, k) => (
              <button class:list={["pilula", { "is-ativo": k === 0 }]} data-ir={k} aria-current={k === 0 ? "step" : undefined}>
                {e.termo}
              </button>
            ))
          }
        </nav>

        <div class="letreiros">
          {
            etapas.map((e, k) => (
              <div class:list={["letreiro", { "is-ativo": k === 0 }]} data-k={k}>
                <h3 class="letreiro__grande">
                  {e.grande.split(" ").map((w, i) => (
                    <span class="p">
                      <span style={`--i:${i}`}>{w}</span>
                    </span>
                  ))}
                </h3>
                <p class="letreiro__d">{e.d}</p>
              </div>
            ))
          }
        </div>
        <span class="cena__nota">Valores de exemplo</span>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-filme]").forEach((filme) => {
    const cena = filme.querySelector<HTMLElement>("[data-cena]")!;
    const pilulas = [...filme.querySelectorAll<HTMLButtonElement>("[data-ir]")];
    const letreiros = [...filme.querySelectorAll<HTMLElement>(".letreiro")];
    const n = letreiros.length;
    const ABRE = 0.12; // primeira parte da rolagem: a foto abre até a tela cheia
    let atual = 0;
    let quadro = 0;

    const marcar = (k: number) => {
      if (k === atual) return;
      atual = k;
      letreiros.forEach((l, i) => l.classList.toggle("is-ativo", i === k));
      pilulas.forEach((p, i) => {
        p.classList.toggle("is-ativo", i === k);
        if (i === k) p.setAttribute("aria-current", "step");
        else p.removeAttribute("aria-current");
      });
      const p = pilulas[k];
      const fila = p.parentElement!;
      if (fila.scrollWidth > fila.clientWidth) fila.scrollTo({ left: p.offsetLeft - (fila.clientWidth - p.offsetWidth) / 2, behavior: "smooth" });
    };

    // Progresso da rolagem dentro do trecho fixo (0 a 1).
    const progresso = () => {
      const r = filme.getBoundingClientRect();
      const total = r.height - innerHeight;
      return total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
    };
    const atualizar = () => {
      quadro = 0;
      const p = progresso();
      cena.style.setProperty("--abre", String(Math.min(1, p / ABRE)));
      cena.style.setProperty("--p", p.toFixed(4));
      const q = Math.max(0, (p - ABRE) / (1 - ABRE));
      marcar(Math.min(n - 1, Math.floor(q * n)));
    };
    const pedir = () => {
      if (!quadro) quadro = requestAnimationFrame(atualizar);
    };
    addEventListener("scroll", pedir, { passive: true });
    addEventListener("resize", pedir);
    atualizar();

    // Pílula: rola até o meio daquela etapa.
    pilulas.forEach((b, k) =>
      b.addEventListener("click", () => {
        const r = filme.getBoundingClientRect();
        const total = r.height - innerHeight;
        const alvo = ABRE + ((k + 0.5) / n) * (1 - ABRE);
        scrollTo({ top: scrollY + r.top + alvo * total, behavior: "smooth" });
      }),
    );
  });
</script>

<style>
  .como {
    background: var(--preto);
    color: var(--branco);
  }
  .como__topo {
    display: grid;
    justify-items: center;
    padding-top: clamp(80px, 12vh, 140px);
    padding-bottom: clamp(32px, 5vh, 56px);
  }
  .como__titulo {
    font-size: clamp(36px, 5vw, 76px);
    text-align: center;
  }
  .como__frase {
    margin: 18px 0 0;
    max-width: 30em;
    text-align: center;
    font-size: clamp(17px, 1.4vw, 21px);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.72);
  }

  /* Trecho fixo: a altura dá a rolagem de cada etapa (~60% de tela por etapa). */
  .filme {
    position: relative;
    height: calc(100svh + (var(--n) * 48svh) + 16svh);
  }
  .filme__fixo {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  /* Cena: começa como um quadro arredondado e abre até a tela cheia. */
  .cena {
    --abre: 0;
    --p: 0;
    --lado: clamp(16px, 7vw, 120px);
    position: absolute;
    inset: 0;
    clip-path: inset(
      calc((1 - var(--abre)) * 9svh) calc((1 - var(--abre)) * var(--lado)) calc((1 - var(--abre)) * 9svh)
        round calc((1 - var(--abre)) * 28px)
    );
    background: #1b1d21;
  }
  .cena img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 35% 50%;
    /* Câmera: aproxima devagar e desliza de leve conforme a rolagem. */
    transform: scale(calc(1.18 - var(--p) * 0.14)) translateX(calc((var(--p) - 0.5) * -3%));
    transform-origin: 45% 55%;
    will-change: transform;
  }
  /* Luz de cinema: base escura para o letreiro e vinheta nas bordas. */
  .cena::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8, 8, 10, 0.55) 0%, rgba(8, 8, 10, 0) 22%, rgba(8, 8, 10, 0) 45%, rgba(8, 8, 10, 0.82) 100%),
      radial-gradient(130% 100% at 50% 45%, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.4) 100%);
    pointer-events: none;
  }

  .pilulas {
    position: absolute;
    z-index: 2;
    top: max(84px, 11svh);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    max-width: calc(100% - 24px);
    padding: 5px;
    border-radius: 99px;
    background: rgba(20, 20, 24, 0.35);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    overflow-x: auto;
    scrollbar-width: none;
    opacity: clamp(0, (var(--abre) - 0.7) * 3.4, 1);
  }
  .pilulas::-webkit-scrollbar {
    display: none;
  }
  .pilula {
    flex: none;
    height: 38px;
    padding: 0 16px;
    border-radius: 99px;
    border: 0;
    background: none;
    color: rgba(255, 255, 255, 0.78);
    font-size: 14px;
    font-weight: 500;
    transition:
      background-color 0.4s var(--ease),
      color 0.4s var(--ease);
  }
  .pilula:hover {
    color: var(--branco);
  }
  .pilula.is-ativo {
    background: var(--branco);
    color: var(--preto);
  }
  .pilula:focus-visible {
    outline: 2px solid var(--branco);
    outline-offset: 2px;
  }

  /* Letreiro: texto grande direto sobre a foto, canto inferior esquerdo. */
  .letreiros {
    position: absolute;
    z-index: 2;
    left: var(--margem);
    right: var(--margem);
    bottom: max(40px, 8svh);
    display: grid;
    max-width: 980px;
    opacity: clamp(0, (var(--abre) - 0.7) * 3.4, 1);
  }
  .letreiro {
    grid-area: 1 / 1;
    align-self: end;
    pointer-events: none;
  }
  .letreiro__grande {
    margin: 0;
    font-size: clamp(40px, 6.4vw, 104px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }
  /* Cada palavra sobe de dentro de uma máscara, com atraso orgânico. */
  .letreiro__grande .p {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-right: 0.24em;
    vertical-align: top;
  }
  .letreiro__grande .p > span {
    display: inline-block;
    transform: translateY(105%) rotate(4deg);
    transform-origin: 0 100%;
    filter: blur(6px);
    opacity: 0;
    transition:
      transform 0.5s var(--ease),
      filter 0.5s var(--ease),
      opacity 0.35s var(--ease);
  }
  .letreiro.is-ativo .letreiro__grande .p > span {
    transform: none;
    filter: none;
    opacity: 1;
    transition:
      transform 1s cubic-bezier(0.16, 1, 0.3, 1) calc(0.12s + var(--i) * 0.06s),
      filter 0.8s var(--ease) calc(0.12s + var(--i) * 0.06s),
      opacity 0.6s var(--ease) calc(0.12s + var(--i) * 0.06s);
  }
  .letreiro:not(.is-ativo) .letreiro__grande .p > span {
    transform: translateY(-60%);
  }
  .letreiro__d {
    margin: 18px 0 0;
    max-width: 34em;
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.3s var(--ease),
      transform 0.4s var(--ease);
  }
  .letreiro.is-ativo .letreiro__d {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s var(--ease) 0.45s,
      transform 0.9s var(--ease) 0.45s;
  }

  .cena__nota {
    opacity: clamp(0, (var(--abre) - 0.7) * 3.4, 1);
    position: absolute;
    z-index: 2;
    right: var(--margem);
    bottom: max(40px, 8svh);
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 700px) {
    .como__titulo {
      font-size: 36px;
    }
    .pilulas {
      left: 12px;
      right: 12px;
      max-width: none;
      transform: none;
    }
    .letreiro__grande {
      font-size: 40px;
    }
    .letreiros {
      bottom: 116px;
    }
    .cena__nota {
      bottom: 90px;
      right: auto;
      left: var(--margem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cena img {
      transform: none;
    }
    .letreiro__grande .p > span,
    .letreiro__d {
      transition: none !important;
      filter: none;
    }
  }
</style>
