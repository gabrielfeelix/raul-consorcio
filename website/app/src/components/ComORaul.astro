---
// "Como funciona o consórcio com você" (item 4 da estrutura combinada com o Raul).
// Formato de conversa: o atendimento dele acontece no WhatsApp. Cada etapa é uma dúvida
// real de cliente e a resposta do Raul, que "digita" e responde quando entra na tela.
// Só afirma o que o site já afirma (compara administradoras, explica antes da assinatura,
// acompanha até a contemplação).
import Seta from "./Seta.astro";
import { wa } from "../data/site";
const conversa = [
  ["Tá, mas por onde a gente começa?", "Por uma conversa. Eu quero entender o que você quer construir, para quando e quanto cabe no seu mês sem apertar o resto."],
  ["E qual administradora é a melhor?", "Depende do seu objetivo. Eu comparo administradoras, grupos e prazos e te mostro o plano que serve para você, e não para mim."],
  ["Tem letra miúda?", "Antes de assinar você entende tudo: taxa de administração, fundo de reserva, seguro, reajuste e a estratégia de lance, com os números do seu caso."],
  ["E depois que eu assinar, sumo do seu radar?", "Não. Eu acompanho as assembleias, a hora do lance e a contemplação, até o bem estar na sua mão."],
];
---

<section class="com" id="com-raul" aria-labelledby="com-titulo">
  <div class="wrap com__in">
    <div class="com__lado">
      <h2 id="com-titulo" class="display com__titulo" data-split>
        <span class="linha"><span>Como é fazer</span></span>
        <span class="linha"><span>consórcio</span></span>
        <span class="linha"><span>com o Raul.</span></span>
      </h2>
      <p class="com__sub" data-reveal>As dúvidas que todo cliente manda antes de começar, e o que ele responde.</p>
      <a href={wa("Oi Raul! Vim pelo site e queria marcar uma conversa sobre consórcio.")} target="_blank" rel="noopener" class="btn btn--branco com__cta" data-reveal>
        Mandar a minha dúvida<Seta />
      </a>
    </div>

    <ol class="chat" data-chat>
      {
        conversa.map(([pergunta, resposta]) => (
          <li class="chat__par">
            <p class="msg msg--cliente">{pergunta}</p>
            <div class="msg msg--raul">
              <img src="/img/raul-avatar.webp" alt="" width="32" height="32" loading="lazy" />
              <div class="msg__corpo">
                <span class="msg__digitando" aria-hidden="true">
                  <i />
                  <i />
                  <i />
                </span>
                <p class="msg__txt">{resposta}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  // Cada par entra quando chega à tela: a dúvida aparece, o Raul digita e responde.
  const reduz = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const pares = [...document.querySelectorAll<HTMLElement>("[data-chat] .chat__par")];
  if (reduz || !("IntersectionObserver" in window)) {
    pares.forEach((p) => p.classList.add("is-on", "is-dito"));
  } else {
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          const p = e.target as HTMLElement;
          io.unobserve(p);
          p.classList.add("is-on");
          setTimeout(() => p.classList.add("is-dito"), 1500);
        }),
      { rootMargin: "0px 0px -22% 0px" },
    );
    pares.forEach((p) => io.observe(p));
  }
</script>

<style>
  .com {
    background: var(--vermelho);
    color: var(--branco);
    padding: clamp(72px, 11vh, 128px) 0;
  }
  .com__in {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 112px);
    align-items: start;
  }
  .com__lado {
    position: sticky;
    top: 110px;
  }
  .com__titulo {
    font-size: clamp(40px, 4.6vw, 76px);
  }
  .com__sub {
    margin-top: 20px;
    max-width: 22em;
    font-size: 17px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.78);
  }
  .com__cta {
    margin-top: 28px;
    --bg: var(--branco);
    color: var(--vermelho);
  }
  .chat {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 28px;
  }
  .chat__par {
    display: grid;
    gap: 10px;
  }
  .msg {
    margin: 0;
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.45;
  }
  .msg--cliente {
    justify-self: end;
    max-width: 78%;
    padding: 12px 16px;
    border-radius: 18px 18px 4px 18px;
    background: rgba(0, 0, 0, 0.22);
    color: var(--branco);
  }
  .msg--raul {
    justify-self: start;
    display: flex;
    align-items: end;
    gap: 10px;
    max-width: 86%;
  }
  .msg--raul img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
  .msg__corpo {
    position: relative;
  }
  .msg__txt {
    margin: 0;
    padding: 14px 18px;
    border-radius: 18px 18px 18px 4px;
    background: var(--branco);
    color: #1a1a1a;
  }
  .msg__digitando {
    position: absolute;
    left: 0;
    bottom: 0;
    display: inline-flex;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 18px 18px 18px 4px;
    background: var(--branco);
    opacity: 0;
  }
  .msg__digitando i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #b0b0b5;
    animation: digita 1s infinite;
  }
  .msg__digitando i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .msg__digitando i:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes digita {
    50% {
      transform: translateY(-3px);
      opacity: 0.5;
    }
  }

  /* Coreografia (só com movimento ligado). O espaço da resposta existe desde o início:
     nada empurra a página. Pergunta entra, Raul digita, a resposta abre a partir do avatar. */
  :global(html.js-motion) .msg--cliente {
    opacity: 0;
    transform: translateY(10px) scale(0.96);
    transform-origin: 100% 100%;
    transition:
      opacity 0.4s var(--ease),
      transform 0.55s var(--ease);
  }
  :global(html.js-motion) .msg--raul img {
    opacity: 0;
    transition: opacity 0.4s var(--ease) 0.35s;
  }
  :global(html.js-motion) .msg__txt {
    visibility: hidden;
    clip-path: inset(calc(100% - 46px) calc(100% - 64px) 0 0 round 18px 18px 18px 4px);
    color: transparent;
    transition:
      clip-path 0.7s var(--ease),
      color 0.5s var(--ease) 0.25s;
  }
  :global(html.js-motion) .chat__par.is-on .msg--cliente {
    opacity: 1;
    transform: none;
  }
  :global(html.js-motion) .chat__par.is-on .msg--raul img {
    opacity: 1;
  }
  :global(html.js-motion) .chat__par.is-on:not(.is-dito) .msg__digitando {
    opacity: 1;
    transition: opacity 0.3s var(--ease) 0.45s;
  }
  :global(html.js-motion) .chat__par.is-dito .msg__txt {
    visibility: visible;
    clip-path: inset(0 0 0 0 round 18px 18px 18px 4px);
    color: #1a1a1a;
  }

  @media (max-width: 860px) {
    .com__in {
      grid-template-columns: 1fr;
    }
    .com__lado {
      position: static;
    }
    .com__titulo {
      font-size: 34px;
    }
    .com__sub {
      font-size: 16px;
    }
    .com__cta {
      display: none;
    }
    .chat {
      gap: 22px;
    }
    .msg--cliente {
      max-width: 86%;
    }
    .msg--raul {
      max-width: 94%;
    }
  }
</style>
