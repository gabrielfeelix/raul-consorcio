---
// Versão B: a capa começa pelo sonho de quem chega, não pelo consultor.
// Uma imagem só e texto genérico: serve para casa, carro, máquina ou investimento.
import Seta from "../Seta.astro";
---

<section class="hero heroB" id="topo">
  <div class="hero__foto heroB__foto" aria-hidden="true">
    <img src="/img/b-hero.webp" alt="" fetchpriority="high" decoding="async" />
  </div>
  <div class="heroB__veu" aria-hidden="true"></div>

  <div class="wrap heroB__in">
    <p class="heroB__olho" data-reveal>Consórcio sem juros, explicado sem complicação</p>
    <h1 class="heroB__titulo" data-split>
      <span class="linha"><span>Do sonho</span></span>
      <span class="linha"><span>ao que é seu<em>.</em></span></span>
    </h1>
    <p class="heroB__sub" data-reveal>
      Casa, carro, máquina ou investimento. Você já sabe o que quer. A gente mostra como chegar lá sem juros, num plano
      que cabe no seu mês.
    </p>
    <div class="heroB__acoes" data-reveal>
      <a href="#simulacao" class="btn">Ver se cabe no meu bolso<Seta /></a>
      <a href="#travas" class="heroB__link">Entender antes</a>
    </div>
  </div>
</section>

<style>
  .heroB {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--preto);
    isolation: isolate;
  }
  .heroB__foto,
  .heroB__veu {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .heroB__foto img {
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: 18% 45%;
  }
  .heroB__veu {
    background:
      linear-gradient(0deg, rgba(11, 11, 12, 0.92) 0%, rgba(11, 11, 12, 0.45) 40%, rgba(11, 11, 12, 0) 70%),
      linear-gradient(90deg, rgba(11, 11, 12, 0.55) 0%, rgba(11, 11, 12, 0) 55%);
  }
  .heroB__in {
    width: 100%;
    padding-top: 140px;
    padding-bottom: clamp(48px, 10vh, 112px);
  }
  .heroB__olho {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }
  .heroB__titulo {
    margin: 22px 0 0;
    font-size: clamp(52px, 6.6vw, 116px);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }
  .heroB__titulo em {
    font-style: normal;
    color: var(--vermelho);
  }
  .heroB__sub {
    margin-top: 28px;
    max-width: 32em;
    font-size: clamp(17px, 1.3vw, 20px);
    color: rgba(255, 255, 255, 0.82);
  }
  .heroB__acoes {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 36px;
    flex-wrap: wrap;
  }
  .heroB__link {
    font-size: 15px;
    font-weight: 600;
    padding-bottom: 3px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
  }
  .heroB__link:hover {
    border-color: var(--branco);
  }

  @media (max-width: 760px) {
    .heroB__foto img {
      object-position: 64% 50%;
    }
    .heroB__in {
      padding-bottom: 36px;
    }
    .heroB__titulo {
      font-size: clamp(48px, 14vw, 64px);
    }
    .heroB__sub {
      margin-top: 18px;
      font-size: 16px;
    }
    .heroB__acoes {
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
      margin-top: 28px;
    }
    .heroB__acoes .btn {
      justify-content: center;
    }
    .heroB__link {
      align-self: center;
    }
  }
</style>
