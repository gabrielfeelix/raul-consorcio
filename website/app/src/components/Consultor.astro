---
import Seta from "./Seta.astro";
import { wa } from "../data/site";
---

<section class="raul" id="consultor">
  <figure class="raul__foto">
    <img src="/img/raul-trabalho.webp" alt="Raul preparando a simulação de um cliente no escritório" loading="lazy" data-raul-foto />
  </figure>

  <div class="raul__conteudo">
    <h2 class="display raul__nome" data-split>
      <span class="linha"><span>Raul Carvalho</span></span>
    </h2>
    <p class="raul__cargo" data-reveal>Especialista em consórcio</p>

    <blockquote class="raul__fala" data-reveal>
      “Antes de falar de parcela, eu quero entender o que você quer construir. E se o consórcio não for o caminho, eu
      falo.”
    </blockquote>

    <p class="raul__fatos" data-reveal>
      <strong>8 anos</strong> de experiência comercial, <strong>mais de 100 clientes</strong> atendidos com consórcio, <strong>presencial e online</strong> em todo o Brasil.
    </p>

    <a href={wa("Oi Raul! Vim pelo site e queria conversar sobre consórcio.")} target="_blank" rel="noopener" class="raul__cta" data-reveal>Conversar com o Raul<Seta /></a>
  </div>
</section>

<style>
  .raul {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 88svh;
    background: var(--papel);
    color: #111;
  }
  .raul__foto {
    margin: 0;
    position: relative;
    overflow: hidden;
    background: #d9d4cc;
  }
  .raul__foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .raul__conteudo {
    align-self: center;
    justify-self: center;
    padding: clamp(64px, 10vh, 120px) clamp(24px, 6vw, 112px);
    max-width: 720px;
  }
  .raul__nome {
    font-size: clamp(40px, 4.2vw, 68px);
    white-space: nowrap;
  }
  .raul__cargo {
    margin-top: 16px;
    font-size: 15px;
    font-weight: 600;
    color: var(--vermelho);
  }
  .raul__fala {
    margin: 40px 0 0;
    font-size: clamp(26px, 2.8vw, 46px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.18;
    color: #1a1a1a;
    max-width: 17em;
    text-indent: -0.42em;
  }
  .raul__fatos {
    margin: 36px 0 0;
    max-width: 30em;
    font-size: 16px;
    line-height: 1.6;
    color: #6b6b6f;
  }
  .raul__fatos strong {
    font-weight: 600;
    color: #111;
  }
  .raul__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 48px;
    font-weight: 600;
    color: var(--vermelho);
    border-bottom: 1px solid currentColor;
    padding-bottom: 4px;
  }
  .raul__cta:hover :global(.btn__seta) {
    transform: translate(3px, -3px);
  }
  @media (max-width: 860px) {
    .raul {
      grid-template-columns: 1fr;
    }
    .raul__foto {
      height: 44svh;
    }
    .raul__foto img {
      object-position: 50% 12%;
    }
    .raul__conteudo {
      padding-top: 40px;
      padding-bottom: 56px;
    }

    .raul__nome {
      white-space: normal;
    }
  }
</style>
