---
import Seta from "./Seta.astro";
import { wa } from "../data/site";
const fatos = [
  ["8 anos", "de experiência comercial"],
  ["Mais de 100 clientes", "atendidos com consórcio"],
  ["Presencial e online", "em todo o Brasil"],
];
---

<section class="raul" id="consultor">
  <figure class="raul__foto">
    <img src="/img/raul-trabalho.webp" alt="Raul preparando a simulação de um cliente no escritório" loading="lazy" data-raul-foto />
  </figure>

  <div class="raul__conteudo">
    <h2 class="display raul__nome" data-split>
      <span class="linha"><span>Raul Carvalho</span></span>
    </h2>
    <p class="raul__cargo" data-reveal>Especialista em consórcio</p>

    <blockquote class="raul__fala" data-reveal>
      “Antes de falar de parcela, eu quero entender o que você quer construir. E se o consórcio não for o caminho, eu
      falo.”
    </blockquote>

    <ul class="raul__fatos" data-reveal>
      {
        fatos.map(([n, l]) => (
          <li>
            <strong>{n}</strong> <span>{l}</span>
          </li>
        ))
      }
    </ul>

    <a href={wa("Oi Raul! Vim pelo site e queria conversar sobre consórcio.")} target="_blank" rel="noopener" class="raul__cta" data-reveal>Conversar com o Raul<Seta /></a>
  </div>
</section>

<style>
  .raul {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 100svh;
    background: var(--papel);
    color: #111;
  }
  .raul__foto {
    margin: 0;
    position: relative;
    overflow: hidden;
    background: #d9d4cc;
  }
  .raul__foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .raul__conteudo {
    align-self: center;
    padding: clamp(64px, 10vh, 120px) clamp(24px, 6vw, 112px);
    max-width: 720px;
  }
  .raul__nome {
    font-size: clamp(40px, 4.2vw, 68px);
    white-space: nowrap;
  }
  .raul__cargo {
    margin-top: 16px;
    font-size: 15px;
    font-weight: 600;
    color: var(--vermelho);
  }
  .raul__fala {
    margin: 40px 0 0;
    font-size: clamp(24px, 2.1vw, 34px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.28;
    color: #1a1a1a;
    max-width: 19em;
    text-indent: -0.42em;
  }
  .raul__fatos {
    list-style: none;
    margin: 44px 0 0;
    padding: 0;
    max-width: 30em;
    border-top: 1px solid var(--linha-clara);
  }
  .raul__fatos li {
    padding: 14px 0;
    border-bottom: 1px solid var(--linha-clara);
    font-size: 16px;
    color: #6b6b6f;
  }
  .raul__fatos strong {
    font-weight: 600;
    color: #111;
  }
  .raul__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 48px;
    font-weight: 600;
    color: var(--vermelho);
    border-bottom: 1px solid currentColor;
    padding-bottom: 4px;
  }
  .raul__cta:hover :global(.btn__seta) {
    transform: translate(3px, -3px);
  }
  @media (max-width: 860px) {
    .raul {
      grid-template-columns: 1fr;
    }
    .raul__foto {
      height: 62svh;
    }

    .raul__nome {
      white-space: normal;
    }
  }
</style>
