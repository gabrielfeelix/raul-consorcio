---
import Seta from "./Seta.astro";
const fatos = [
  ["8 anos", "de experiência comercial"],
  ["Multimarcas", "compara várias administradoras"],
  ["Maringá/PR", "atende presencial e online"],
];
---

<section class="raul" id="consultor">
  <figure class="raul__foto">
    <img src="/img/raul-trabalho.webp" alt="Raul preparando a simulação de um cliente no escritório" loading="lazy" data-raul-foto />
  </figure>

  <div class="raul__conteudo">
    <p class="rotulo" data-reveal><b>01</b> Quem vai te atender</p>
    <h2 class="display raul__nome" data-split>
      <span class="linha"><span>Raul</span></span>
      <span class="linha"><span>Carvalho</span></span>
    </h2>
    <p class="raul__cargo" data-reveal>Consultor de consórcio</p>

    <blockquote class="raul__fala" data-reveal>
      Antes de falar de parcela, eu quero entender o que você quer construir. E se o consórcio não for o caminho, eu
      falo.
    </blockquote>

    <ul class="raul__fatos" data-reveal>
      {
        fatos.map(([n, l]) => (
          <li>
            <strong>{n}</strong>
            <span>{l}</span>
          </li>
        ))
      }
    </ul>

    <a href="#simulacao" class="raul__cta" data-reveal>Conversar com o Raul<Seta /></a>
  </div>
</section>

<style>
  .raul {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 100svh;
    background: var(--papel);
    color: #111;
  }
  .raul__foto {
    margin: 0;
    position: relative;
    overflow: hidden;
    background: #d9d4cc;
  }
  .raul__foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .raul__conteudo {
    align-self: center;
    padding: clamp(64px, 10vh, 120px) clamp(24px, 6vw, 112px);
    max-width: 720px;
  }
  .raul .rotulo {
    color: #6b6b6f;
  }
  .raul__nome {
    margin-top: 28px;
    font-size: clamp(48px, 5.4vw, 92px);
  }
  .raul__cargo {
    margin-top: 16px;
    font-size: 15px;
    font-weight: 600;
    color: var(--vermelho);
  }
  .raul__fala {
    margin: 44px 0 0;
    padding-left: 20px;
    border-left: 2px solid var(--vermelho);
    font-size: clamp(19px, 1.5vw, 23px);
    line-height: 1.5;
    color: #2d2d2d;
    max-width: 26em;
  }
  .raul__fatos {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 32px;
  }
  .raul__fatos strong {
    display: block;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .raul__fatos span {
    font-size: 13px;
    color: #6b6b6f;
  }
  .raul__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 48px;
    font-weight: 600;
    color: var(--vermelho);
    border-bottom: 1px solid currentColor;
    padding-bottom: 4px;
  }
  .raul__cta:hover :global(.btn__seta) {
    transform: translate(3px, -3px);
  }
  @media (max-width: 860px) {
    .raul {
      grid-template-columns: 1fr;
    }
    .raul__foto {
      height: 62svh;
    }

    .raul__fatos {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
