---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Consultor from "../components/Consultor.astro";
import Construcao from "../components/Construcao.astro";
import ComORaul from "../components/ComORaul.astro";
import Simulacao from "../components/Simulacao.astro";
import Videos from "../components/Videos.astro";
import Faq from "../components/Faq.astro";
import BarraCta from "../components/BarraCta.astro";
import Rodape from "../components/Rodape.astro";
---

<Base>
  <Nav />
  <main>
    <Hero />
    <Consultor />
    <Construcao />
    <ComORaul modelo="jornada" />
    <Simulacao />
    <Videos />
    <Faq />
  </main>
  <Rodape />
  <BarraCta />
</Base>
